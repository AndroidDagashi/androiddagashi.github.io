  "type": "module",
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/introspection": "7.0.0",
    "@graphql-codegen/near-operation-file-preset": "6.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-document-nodes": "7.0.0",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@types/node": "26.6.6",
    "graphql": "16.15.0",
    "site-types": "1.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@octokit/graphql": "9.0.5",
    "site-common": "1.0.0"
  },
  "scripts": {
    "graphql:schema": "graphql-codegen --config codegen.schema.ts",
